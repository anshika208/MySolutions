class Solution {
public:
//using BFS
    vector<vector<int>> floodFill(vector<vector<int>>& image, int sr, int sc, int color) {
        int givenNodeColor = image[sr][sc];
        int m = image.size();
        int n = image[0].size();
        queue <pair<int,int>> q;
        vector<vector<int>> vis(m,vector<int>(n,0));

        q.push({sr,sc});
        vis[sr][sc] = 1;
        image[sr][sc] = color;
        int drow[] = {-1,0,1,0};
        int dcol[] = {0,1,0,-1};
         while(!q.empty()){
            int frontRow = q.front().first;
            int frontCol = q.front().second;
            q.pop();
            for(int i= 0; i<4; i++){
             int nrow = frontRow + drow[i];
             int ncol = frontCol + dcol[i];

             if(nrow>=0 && nrow<m && ncol>=0 && ncol<n && !vis[nrow][ncol] && image[nrow][ncol] == givenNodeColor){
                q.push({nrow,ncol});
                vis[nrow][ncol] = 1;
                image[nrow][ncol] = color;
             }
            }
         }

        return image;
    }
};
