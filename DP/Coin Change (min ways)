class Solution {
  public:
    int minCoins(vector<int> &coins, int sum) {
        // code here
        int n = coins.size();
        vector<vector<int>> dp(n,vector<int>(sum+1,0));
        
        for(int j =0; j<=sum;j++){
            if(j % coins[0] == 0){
                dp[0][j] = j / coins[0];
            }else{
                dp[0][j] = 1e9;
            }
        };
        
        for(int i = 1; i<n;i++){
            for(int j=0;j<=sum;j++){
                int notTake = 0 + dp[i-1][j];
                int take = INT_MAX;
                if(coins[i]<=j){
                    take = 1 + dp[i][j - coins[i]];
                }
                dp[i][j] = min(take,notTake);
            }
        };
        
        int ans = dp[n-1][sum];
        if(ans >= 1e9) return -1;
        return ans;
    }
};
