class Solution {

  public:
    int minDifference(vector<int>& arr) {
        int n = arr.size();
        int sum = 0;
     for(int i = 0; i<n;i++){
         sum+=arr[i];
     }
    vector<vector<bool>> dp (n,vector<bool>(sum + 1,0));
    //now base case for this target
    for(int i =0;i<n;i++) dp[i][0] = true;
    if(arr[0] <= sum) dp[0][arr[0]] = true;
    
    for(int i = 1; i<n;i++){
        for(int j= 1; j<=sum; j++){
            bool notTake  = dp[i-1][j];
            bool take = false;
            if(arr[i]<=sum){
                take = dp[i-1][j-arr[i]];
            };
            dp[i][j] = take || notTake;
        }
    };
     int minimum = 1e9;
    for(int j = 0; j<=sum/2;j++){
        if(dp[n-1][j] == true){
        int s1 = j;
        int s2 = sum - j;
        minimum = min((abs(s2-s1)),minimum);
        }
        
    };
    return minimum;
    }
   
};
